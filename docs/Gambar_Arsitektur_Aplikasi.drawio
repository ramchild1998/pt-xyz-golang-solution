        <mxCell id="63KGp4usUAZ6CjWQhUcA-8" value="Consumer Services" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=light-dark(default, #ffffff);" vertex="1" parent="1">
          <mxGeometry x="540" y="126" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="63KGp4usUAZ6CjWQhUcA-9" value="&#xa;&lt;span class=&quot;citation-165 citation-end-165&quot;&gt;Bertanggung jawab untuk mengelola semua data personal konsumen, seperti NIK, nama, alamat, dll&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;4&quot;&gt;&lt;/sup&gt;&lt;/span&gt;.&#xa;&#xa;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=light-dark(default, #ffffff);" vertex="1" parent="1">
          <mxGeometry x="525.25" y="180" width="90.25" height="150" as="geometry" />
        </mxCell>
        <mxCell id="63KGp4usUAZ6CjWQhUcA-10" value="Bertanggung jawab untuk &lt;em&gt;routing&lt;/em&gt;, &lt;em&gt;load balancing&lt;/em&gt;, otentikasi, dan &lt;em&gt;rate limiting&lt;/em&gt;. Ini menyederhanakan akses client ke &lt;em&gt;microservices&lt;/em&gt;." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=light-dark(default, #ffffff);" vertex="1" parent="1">
          <mxGeometry x="360.25" y="170" width="90" height="150" as="geometry" />
        </mxCell>
        <mxCell id="63KGp4usUAZ6CjWQhUcA-11" value="Pengguna akhir yang mengakses sistem melalui berbagai platform." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=light-dark(default, #ffffff);" vertex="1" parent="1">
          <mxGeometry x="176.75" y="180" width="90" height="100" as="geometry" />
        </mxCell>
        <mxCell id="63KGp4usUAZ6CjWQhUcA-12" value="Transaction Services" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;bpmnShapeType=transaction;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" vertex="1" parent="1">
          <mxGeometry x="166.25" y="385" width="111" height="70" as="geometry" />
        </mxCell>
        <mxCell id="63KGp4usUAZ6CjWQhUcA-13" value="&lt;span class=&quot;citation-164 citation-end-164&quot;&gt;Bertanggung jawab untuk mengelola semua data transaksi, termasuk pengajuan pinjaman, limit tenor &lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;5&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span class=&quot;citation-163 citation-end-163&quot;&gt;, dan detail kontrak&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;6&quot;&gt;&lt;/sup&gt;&lt;/span&gt;. Layanan ini akan menangani logika bisnis utama seperti pengecekan limit dan pembuatan kontrak baru." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=light-dark(default, #ffffff);" vertex="1" parent="1">
          <mxGeometry x="160" y="530" width="123.5" height="200" as="geometry" />
        </mxCell>
        <mxCell id="63KGp4usUAZ6CjWQhUcA-14" value="" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#00BEF2;shape=mxgraph.azure.mysql_database;" vertex="1" parent="1">
          <mxGeometry x="386.5" y="395" width="37.5" height="50" as="geometry" />
        </mxCell>
        <mxCell id="63KGp4usUAZ6CjWQhUcA-15" value="MySQL DB" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=light-dark(default, #ffffff);" vertex="1" parent="1">
          <mxGeometry x="375.25" y="480" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="63KGp4usUAZ6CjWQhUcA-17" value="Setiap layanan memiliki database terisolasi sendiri (&lt;em&gt;Database per Service&lt;/em&gt;) untuk memastikan &lt;em&gt;loose coupling&lt;/em&gt;. &lt;span class=&quot;citation-162&quot;&gt;Ini adalah prinsip inti dari arsitektur &lt;/span&gt;&lt;em&gt;microservices&lt;/em&gt;&lt;span class=&quot;citation-162&quot;&gt; dan mendukung &lt;/span&gt;&lt;em&gt;durability&lt;/em&gt;&lt;span class=&quot;citation-162&quot;&gt; dan &lt;/span&gt;&lt;em&gt;consistency&lt;/em&gt;&lt;span class=&quot;citation-162 citation-end-162&quot;&gt; (ACID) pada level layanan.&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;7&quot;&gt;&lt;/sup&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=light-dark(default, #ffffff);" vertex="1" parent="1">
          <mxGeometry x="343.5" y="530" width="123.5" height="220" as="geometry" />
        </mxCell>
        <mxCell id="63KGp4usUAZ6CjWQhUcA-18" value="" style="image;sketch=0;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/mscae/Docker.svg;" vertex="1" parent="1">
          <mxGeometry x="540.25" y="395" width="61.59" height="50.5" as="geometry" />
        </mxCell>
        <mxCell id="63KGp4usUAZ6CjWQhUcA-19" value="&lt;span class=&quot;citation-161&quot;&gt;Seluruh layanan dan database akan dijalankan di dalam kontainer Docker, diatur oleh Docker Compose untuk lingkungan pengembangan dan Kubernetes untuk produksi, guna mencapai &lt;/span&gt;&lt;em&gt;high availability&lt;/em&gt;&lt;span class=&quot;citation-161&quot;&gt; dan &lt;/span&gt;&lt;em&gt;scalability&lt;/em&gt;&lt;span class=&quot;citation-161 citation-end-161&quot;&gt;&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;8&quot;&gt;&lt;/sup&gt;&lt;/span&gt;." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=light-dark(default, #ffffff);" vertex="1" parent="1">
          <mxGeometry x="508.63" y="530" width="123.5" height="220" as="geometry" />
        </mxCell>
        <mxCell id="63KGp4usUAZ6CjWQhUcA-20" value="Containerization (Docker)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=light-dark(default, #ffffff);" vertex="1" parent="1">
          <mxGeometry x="540.25" y="480" width="60" height="30" as="geometry" />
        </mxCell>
